[Unit]
Description=TitanGold Engine Worker (Always-on Runtime)
After=network.target postgresql.service titan-api.service
Wants=postgresql.service
Requires=titan-api.service

[Service]
Type=simple
User=titangold
Group=titangold
WorkingDirectory=/opt/titangold/backend
Environment=NODE_ENV=production
EnvironmentFile=/opt/titangold/.env
# Engine-specific env vars (must be in .env)
# ENGINE_ENABLED=true
# ENGINE_TICK_INTERVAL_MS=60000
# ENGINE_MAX_BACKOFF_MS=300000
ExecStart=/usr/bin/node workers/engineWorker.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=titan-engine

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/titangold/backend/logs

# Resource limits
LimitNOFILE=65536
MemoryMax=1G

[Install]
WantedBy=multi-user.target

