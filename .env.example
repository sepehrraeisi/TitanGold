# TitanGold Docker Compose Environment Variables

# Redis Configuration
REDIS_PASSWORD=<your-secure-password-here>

# CORS Configuration (API-006)
# Comma-separated list of allowed origins
# Development example: http://localhost:3000,http://localhost:5173
# Production example: https://titangold.com,https://app.titangold.com,https://api.titangold.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
