{
  "apps": [
    {
      "name": "telegram-collector",
      "script": "./dist/index.js",
      "cwd": "/home/ubuntu/webapp/TitanGold/telegram-collector",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "PORT": "5003"
