      "env_file": "/home/ubuntu/webapp/TitanGold/backend/.env",
      "error_file": "/home/ubuntu/.pm2/logs/telegram-collector-error.log",
      "out_file": "/home/ubuntu/.pm2/logs/telegram-collector-out.log",
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "512M"
    }
  ]
}
