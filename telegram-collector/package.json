{
  "name": "telegram-collector",
  "version": "0.1.0",
  "description": "MTProto-based Telegram collector service for Titan Data Hub",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --test services/__tests__/channelPolling.stabilization.test.js services/__tests__/channelPolling.connectLifecycle.test.js services/__tests__/messageProcessor.scheduling.test.js",
    "start": "node dist/index.js",
    "auth": "ts-node src/auth/generateSession.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "input": "^1.0.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "redis": "^4.7.1",
    "telegram": "^2.26.22",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
