{
  "name": "titangold-backend",
  "version": "1.0.0",
  "description": "TitanGold Professional Trading Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node database/migrate.js",
    "migrate:up": "node database/migrate.js up",
    "migrate:down": "node database/migrate.js down",
    "migrate:create": "node database/migrate.js create",
    "migrate:status": "node database/migrate.js status",
    "migrate:redo": "node database/migrate.js redo",
    "migrate:setup": "node scripts/setup_migrations.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest __tests__/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest __tests__/integration",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --maxWorkers=2",
    "test:verbose": "NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk node_modules/.bin/jest --runInBand"
  },
  "keywords": [
    "trading",
    "api",
    "postgresql",
    "express"
  ],
  "author": "TitanGold Team",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^5.3.0",
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@google/generative-ai": "^0.1.3",
    "amqplib": "^0.10.3",
    "arima": "^0.2.5",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "ccxt": "^4.1.100",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "graphql": "^16.12.0",
    "graphql-tag": "^2.12.6",
    "helmet": "^7.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^15.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^8.1.0",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.11.3",
    "playwright": "^1.58.2",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.3",
    "redis": "^4.6.13",
    "regression": "^2.0.1",
    "robots-parser": "^3.0.1",
    "sentiment": "^5.0.2",
    "simple-statistics": "^7.8.8",
    "speakeasy": "^2.0.0",
    "stream-json": "^1.9.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "ws": "^8.17.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "tough-cookie": "^4.1.3",
    "form-data": "^4.0.0"
  }
}
